-- =====================================================================
-- Cek kualitas data di Bronze
-- =====================================================================
-- =========================================================
-- bronze.customers
-- =========================================================
-- PK: NULL & duplikat
SELECT customer_id, COUNT(*) AS jml
FROM bronze.customers
GROUP BY customer_id
HAVING COUNT(*) > 1 OR customer_id IS NULL;
 
-- Missing values kolom wajib
SELECT
    SUM(CASE WHEN name IS NULL OR name = '' THEN 1 ELSE 0 END)   AS null_name,
    SUM(CASE WHEN dob IS NULL THEN 1 ELSE 0 END)                 AS null_dob,
    SUM(CASE WHEN registration_date IS NULL THEN 1 ELSE 0 END)   AS null_reg_date,
    SUM(CASE WHEN kyc_status IS NULL THEN 1 ELSE 0 END)          AS null_kyc,
    SUM(CASE WHEN referral_code IS NULL OR referral_code = ''
             THEN 1 ELSE 0 END)                                  AS kosong_referral
FROM bronze.customers;   -- referral kosong ~30% = wajar, jadi 'direct'
 
-- Unwanted spaces
SELECT customer_id
FROM bronze.customers
WHERE name     <> TRIM(name)
   OR city     <> TRIM(city)
   OR province <> TRIM(province)
   OR email    <> TRIM(email);
 
-- Standardisasi kolom low-cardinality
SELECT DISTINCT kyc_status FROM bronze.customers;
SELECT DISTINCT gender     FROM bronze.customers;
SELECT DISTINCT province   FROM bronze.customers;
 
-- Outlier / invalid value: umur di luar batas nasabah bank (17-100)
SELECT customer_id, dob, registration_date
FROM bronze.customers
WHERE dob > GETDATE()
   OR DATEDIFF(YEAR, dob, GETDATE()) NOT BETWEEN 17 AND 100
   OR registration_date > GETDATE();
 
-- Structural error: registrasi sebelum lahir
SELECT customer_id, dob, registration_date
FROM bronze.customers
WHERE registration_date < dob;
 
-- =========================================================
-- bronze.accounts
-- =========================================================
-- PK: NULL & duplikat
SELECT account_id, COUNT(*) AS jml
FROM bronze.accounts
GROUP BY account_id
HAVING COUNT(*) > 1 OR account_id IS NULL;
 
-- Standardisasi kolom low-cardinality
SELECT DISTINCT account_type FROM bronze.accounts;
SELECT DISTINCT status       FROM bronze.accounts;
SELECT DISTINCT tier         FROM bronze.accounts;
 
-- Outlier / invalid value: saldo negatif
SELECT * FROM bronze.accounts WHERE balance_idr < 0;
 
-- Referential integrity: akun -> nasabah
SELECT DISTINCT a.customer_id
FROM bronze.accounts a
WHERE a.customer_id NOT IN (SELECT customer_id FROM bronze.customers);
 
-- Structural error: akun dibuat sebelum nasabah registrasi
SELECT a.account_id, a.created_date, c.registration_date
FROM bronze.accounts a
JOIN bronze.customers c ON a.customer_id = c.customer_id
WHERE a.created_date < c.registration_date;
 
-- =========================================================
-- bronze.transactions
-- =========================================================
-- PK: NULL & duplikat
SELECT trx_id, COUNT(*) AS jml
FROM bronze.transactions
GROUP BY trx_id
HAVING COUNT(*) > 1 OR trx_id IS NULL;
 
-- Standardisasi kolom low-cardinality
SELECT DISTINCT trx_type          FROM bronze.transactions;
SELECT DISTINCT status            FROM bronze.transactions;
SELECT DISTINCT channel           FROM bronze.transactions;
SELECT DISTINCT merchant_category FROM bronze.transactions;
 
-- Outlier / invalid value: nominal & jam tidak wajar
SELECT COUNT(*) AS amount_invalid FROM bronze.transactions WHERE amount_idr <= 0;
SELECT MIN(amount_idr) AS min_amount, MAX(amount_idr) AS max_amount FROM bronze.transactions;
SELECT COUNT(*) AS jam_invalid
FROM bronze.transactions
WHERE DATEPART(HOUR, trx_time) NOT BETWEEN 0 AND 23;
 
-- Referential integrity: transaksi -> akun
SELECT DISTINCT t.account_id
FROM bronze.transactions t
WHERE t.account_id NOT IN (SELECT account_id FROM bronze.accounts);
 
-- Structural error: transaksi sebelum akun dibuat / di masa depan
SELECT t.trx_id, t.trx_date, a.created_date
FROM bronze.transactions t
JOIN bronze.accounts a ON t.account_id = a.account_id
WHERE t.trx_date < a.created_date OR t.trx_date > GETDATE();
 
-- =========================================================
-- bronze.loans
-- =========================================================
-- PK: NULL & duplikat
SELECT loan_id, COUNT(*) AS jml
FROM bronze.loans
GROUP BY loan_id
HAVING COUNT(*) > 1 OR loan_id IS NULL;
 
-- Standardisasi kolom low-cardinality
SELECT DISTINCT loan_type FROM bronze.loans;
SELECT DISTINCT status    FROM bronze.loans;
 
-- Outlier / invalid value
SELECT *
FROM bronze.loans
WHERE principal_idr <= 0
   OR tenure_months <= 0
   OR interest_rate_annual NOT BETWEEN 0 AND 1   -- desimal, bukan persen
   OR outstanding_idr < 0;
 
-- Business logic: outstanding tidak boleh melebihi pokok pinjaman
SELECT loan_id, principal_idr, outstanding_idr
FROM bronze.loans
WHERE outstanding_idr > principal_idr;
 
-- Structural error: urutan tanggal (disbursement <= due, last_payment >= disbursement)
SELECT loan_id, disbursement_date, due_date, last_payment_date
FROM bronze.loans
WHERE due_date < disbursement_date
   OR last_payment_date < disbursement_date
   OR disbursement_date > GETDATE();
 
-- Referential integrity: pinjaman -> nasabah
SELECT DISTINCT l.customer_id
FROM bronze.loans l
WHERE l.customer_id NOT IN (SELECT customer_id FROM bronze.customers);
 
-- Business logic: pinjaman hanya untuk nasabah KYC verified
SELECT l.loan_id, c.kyc_status
FROM bronze.loans l
JOIN bronze.customers c ON l.customer_id = c.customer_id
WHERE c.kyc_status <> 'verified';
 
-- =========================================================
-- bronze.cards
-- =========================================================
-- PK: NULL & duplikat
SELECT card_id, COUNT(*) AS jml
FROM bronze.cards
GROUP BY card_id
HAVING COUNT(*) > 1 OR card_id IS NULL;
 
-- Standardisasi kolom low-cardinality
SELECT DISTINCT card_type FROM bronze.cards;
SELECT DISTINCT status    FROM bronze.cards;
 
-- Business logic: limit & outstanding hanya untuk kartu kredit
SELECT
    card_type,
    COUNT(*)                                                  AS jml,
    SUM(CASE WHEN credit_limit_idr IS NULL THEN 1 ELSE 0 END) AS limit_null,
    SUM(CASE WHEN outstanding_idr IS NULL THEN 1 ELSE 0 END)  AS outstanding_null
FROM bronze.cards
GROUP BY card_type;   -- ekspektasi: NULL hanya pada card_type = 'debit'
 
-- Outlier: outstanding melebihi limit (over-limit)
SELECT card_id, credit_limit_idr, outstanding_idr
FROM bronze.cards
WHERE card_type = 'credit' AND outstanding_idr > credit_limit_idr;
 
-- Referential integrity: kartu -> nasabah & akun
SELECT DISTINCT k.customer_id
FROM bronze.cards k
WHERE k.customer_id NOT IN (SELECT customer_id FROM bronze.customers);
 
SELECT DISTINCT k.account_id
FROM bronze.cards k
WHERE k.account_id NOT IN (SELECT account_id FROM bronze.accounts);
 
-- Konsistensi: kartu & akun harus milik nasabah yang sama
SELECT k.card_id, k.customer_id AS cust_kartu, a.customer_id AS cust_akun
FROM bronze.cards k
JOIN bronze.accounts a ON k.account_id = a.account_id
WHERE k.customer_id <> a.customer_id;
GO
 
