-- =========================================================
-- silver.customers
-- =========================================================
TRUNCATE TABLE silver.customers;
 
INSERT INTO silver.customers (
    customer_id, name, nik_masked, email, phone, city, province,
    dob, gender, kyc_status, registration_date, referral_code,
    acquisition_channel, age
)
SELECT
    customer_id,
    TRIM(name),
    nik_masked,
    LOWER(TRIM(email)),          -- email disamakan lowercase agar tidak dobel
    TRIM(phone),
    TRIM(city),
    TRIM(province),
    dob,
    gender,
    kyc_status,
    registration_date,
    referral_code,
    -- Asumsi bisnis: referral_code kosong (~30% dataset) = nasabah datang
    -- sendiri, bukan data hilang
    CASE WHEN referral_code IS NULL OR TRIM(referral_code) = ''
         THEN 'direct' ELSE 'referral' END,
    -- Umur per hari ini; dikurangi 1 bila ulang tahun belum lewat
    DATEDIFF(YEAR, dob, GETDATE())
        - CASE WHEN DATEADD(YEAR, DATEDIFF(YEAR, dob, GETDATE()), dob) > GETDATE()
               THEN 1 ELSE 0 END
FROM bronze.customers;
GO
 
-- =========================================================
-- silver.accounts
-- =========================================================
TRUNCATE TABLE silver.accounts;
 
INSERT INTO silver.accounts (
    account_id, customer_id, account_number, account_type,
    balance_idr, created_date, status, tier, balance_segment
)
SELECT
    account_id,
    customer_id,
    account_number,
    account_type,
    balance_idr,
    created_date,
    status,
    tier,
    -- Segmentasi saldo standar perbankan ritel:
    -- < 10 jt mass | 10-100 jt mass affluent | > 100 jt affluent
    CASE
        WHEN balance_idr < 10000000  THEN 'mass'
        WHEN balance_idr < 100000000 THEN 'mass_affluent'
        ELSE 'affluent'
    END
FROM bronze.accounts;
GO
 
-- =========================================================
-- silver.transactions
-- =========================================================
TRUNCATE TABLE silver.transactions;
 
INSERT INTO silver.transactions (
    trx_id, account_id, trx_type, amount_idr, merchant_name,
    merchant_category, trx_date, trx_time, trx_hour, jam_band,
    balance_after_idr, status, channel, is_success
)
SELECT
    trx_id,
    account_id,
    trx_type,
    amount_idr,
    TRIM(merchant_name),
    merchant_category,
    trx_date,
    trx_time,
    DATEPART(HOUR, trx_time),
    -- Band jam untuk analisis pola & failure rate per waktu
    CASE
        WHEN DATEPART(HOUR, trx_time) < 6  THEN '00-06'
        WHEN DATEPART(HOUR, trx_time) < 12 THEN '06-12'
        WHEN DATEPART(HOUR, trx_time) < 18 THEN '12-18'
        ELSE '18-24'
    END,
    balance_after_idr,
    status,
    channel,
    -- Flag sukses: hanya status 'success' yang dihitung sebagai GMV
    CASE WHEN status = 'success' THEN 1 ELSE 0 END
FROM bronze.transactions;
GO
 
-- =========================================================
-- silver.loans
-- =========================================================
TRUNCATE TABLE silver.loans;
 
INSERT INTO silver.loans (
    loan_id, customer_id, loan_type, principal_idr, interest_rate_annual,
    tenure_months, disbursement_date, vintage_year, monthly_installment_idr,
    outstanding_idr, status, is_npl, due_date, last_payment_date
)
SELECT
    loan_id,
    customer_id,
    loan_type,
    principal_idr,
    interest_rate_annual,
    tenure_months,
    disbursement_date,
    YEAR(disbursement_date),
    monthly_installment_idr,
    outstanding_idr,
    status,
    -- Definisi NPL: pinjaman menunggak atau sudah dihapusbukukan
    CASE WHEN status IN ('overdue', 'written_off') THEN 1 ELSE 0 END,
    due_date,
    last_payment_date   -- NULL = belum pernah melakukan pembayaran
FROM bronze.loans;
GO
 
-- =========================================================
-- silver.cards
-- =========================================================
TRUNCATE TABLE silver.cards;
 
INSERT INTO silver.cards (
    card_id, customer_id, account_id, card_type, card_number_masked,
    expiry_date, status, credit_limit_idr, outstanding_idr, utilization_pct
)
SELECT
    card_id,
    customer_id,
    account_id,
    card_type,
    card_number_masked,
    expiry_date,
    status,
    credit_limit_idr,
    outstanding_idr,
    -- Utilisasi hanya bermakna untuk kartu kredit berlimit; kartu debit NULL.
    -- NULLIF menjaga dari pembagian nol.
    CASE WHEN card_type = 'credit' AND credit_limit_idr > 0
         THEN ROUND(outstanding_idr * 100.0 / NULLIF(credit_limit_idr, 0), 2)
    END
FROM bronze.cards;
GO
 
