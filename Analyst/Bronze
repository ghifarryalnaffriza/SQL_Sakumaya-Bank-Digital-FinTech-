-- =========================================================
-- Cek jumlah data
-- =========================================================
SELECT 'customers'    AS tabel, COUNT(*) AS total_baris FROM bronze.customers
UNION ALL SELECT 'accounts',     COUNT(*) FROM bronze.accounts
UNION ALL SELECT 'transactions', COUNT(*) FROM bronze.transactions
UNION ALL SELECT 'loans',        COUNT(*) FROM bronze.loans
UNION ALL SELECT 'cards',        COUNT(*) FROM bronze.cards;
-- Ekspektasi: 1.000 / 1.200 / 10.000 / 300 / 800
GO
 
