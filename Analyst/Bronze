-- =========================================================
-- Create schema
-- =========================================================
IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = 'bronze')
    EXEC('CREATE SCHEMA bronze');
GO
 
-- =========================================================
-- Create table: bronze.customers
-- =========================================================
IF OBJECT_ID('bronze.customers', 'U') IS NOT NULL
    DROP TABLE bronze.customers;
GO
 
CREATE TABLE bronze.customers (
    customer_id       VARCHAR(20),
    name              NVARCHAR(100),
    nik_masked        VARCHAR(30),
    email             VARCHAR(100),
    phone             VARCHAR(30),
    city              VARCHAR(50),
    province          VARCHAR(50),
    dob               DATE,
    gender            VARCHAR(10),
    kyc_status        VARCHAR(20),
    registration_date DATE,
    referral_code     VARCHAR(30)
);
GO
 
-- =========================================================
-- Create table: bronze.accounts
-- =========================================================
IF OBJECT_ID('bronze.accounts', 'U') IS NOT NULL
    DROP TABLE bronze.accounts;
GO
 
CREATE TABLE bronze.accounts (
    account_id     VARCHAR(20),
    customer_id    VARCHAR(20),
    account_number VARCHAR(30),
    account_type   VARCHAR(30),
    balance_idr    BIGINT,
    created_date   DATE,
    status         VARCHAR(20),
    tier           VARCHAR(20)
);
GO
 
-- =========================================================
-- Create table: bronze.transactions
-- =========================================================
IF OBJECT_ID('bronze.transactions', 'U') IS NOT NULL
    DROP TABLE bronze.transactions;
GO
 
CREATE TABLE bronze.transactions (
    trx_id            VARCHAR(20),
    account_id        VARCHAR(20),
    trx_type          VARCHAR(30),
    amount_idr        BIGINT,
    merchant_name     NVARCHAR(100),
    merchant_category VARCHAR(50),
    trx_date          DATE,
    trx_time          TIME(0),
    balance_after_idr BIGINT,
    status            VARCHAR(20),
    channel           VARCHAR(30)
);
GO
 
-- =========================================================
-- Create table: bronze.loans
-- =========================================================
IF OBJECT_ID('bronze.loans', 'U') IS NOT NULL
    DROP TABLE bronze.loans;
GO
 
CREATE TABLE bronze.loans (
    loan_id                 VARCHAR(20),
    customer_id             VARCHAR(20),
    loan_type               VARCHAR(30),
    principal_idr           BIGINT,
    interest_rate_annual    DECIMAL(5,4),
    tenure_months           INT,
    disbursement_date       DATE,
    monthly_installment_idr BIGINT,
    outstanding_idr         BIGINT,
    status                  VARCHAR(20),
    due_date                DATE,
    last_payment_date       DATE
);
GO
 
-- =========================================================
-- Create table: bronze.cards
-- =========================================================
IF OBJECT_ID('bronze.cards', 'U') IS NOT NULL
    DROP TABLE bronze.cards;
GO
 
CREATE TABLE bronze.cards (
    card_id            VARCHAR(20),
    customer_id        VARCHAR(20),
    account_id         VARCHAR(20),
    card_type          VARCHAR(20),
    card_number_masked VARCHAR(30), 
    expiry_date        VARCHAR(20),
    status             VARCHAR(20),
    credit_limit_idr   BIGINT,
    outstanding_idr    BIGINT
);
GO
 
-- =========================================================
-- Load data
-- TRUNCATE dulu -> mencegah data dobel kalau BULK INSERT diulang
-- FORMAT='CSV' + FIELDQUOTE (SQL Server 2017+): wajib agar field
-- kosong terbaca NULL (bukan '') dan koma dalam tanda kutip aman
-- =========================================================
TRUNCATE TABLE bronze.customers;
 
BULK INSERT bronze.customers
FROM 'D:\Data\customers.csv'
WITH (
    FORMAT = 'CSV',
    FIELDQUOTE = '"',
    FIRSTROW = 2,
    FIELDTERMINATOR = ',',
    ROWTERMINATOR = '\n',   -- jika error coba '0x0a'
    TABLOCK
);
GO
 
